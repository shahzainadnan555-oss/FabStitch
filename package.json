{
  "name": "fabstitch-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import=./scripts/register-loader.mjs scripts/qa/api-client.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "openapi-typescript ${OPENAPI_URL:-https://api.fabstitch.net/openapi.json} -o lib/api/schema.ts",
    "api:health": "node scripts/qa/api-health.mjs",
    "seo": "node --import=./scripts/register-loader.mjs scripts/seo-audit.mts",
    "seo:sitemap": "node --import=./scripts/register-loader.mjs scripts/seo/sitemap-validate.mts",
    "seo:sitemap:audit": "node --import=./scripts/register-loader.mjs scripts/seo/sitemap-validate.mts",
    "seo:robots": "node --import=./scripts/register-loader.mjs scripts/seo/robots-validate.mts",
    "seo:keywords": "node --import=./scripts/register-loader.mjs scripts/seo/generate-keyword-map.mts",
    "seo:keywords:audit": "node --import=./scripts/register-loader.mjs scripts/seo/keyword-coverage-audit.mts",
    "seo:semantic": "node --import=./scripts/register-loader.mjs scripts/seo/semantic-audit.mts",
    "seo:marketplace": "node --import=./scripts/register-loader.mjs scripts/seo/marketplace-audit.mts",
    "seo:marketplace:audit": "node --import=./scripts/register-loader.mjs scripts/seo/marketplace-audit.mts",
    "seo:fabric-questions": "node --import=./scripts/register-loader.mjs scripts/seo/fabric-questions-audit.mts",
    "seo:technical-audit": "node --import=./scripts/register-loader.mjs scripts/seo/technical-audit.mts",
    "seo:metadata-quality": "node --import=./scripts/register-loader.mjs scripts/seo/metadata-quality-audit.mts",
    "seo:image-audit": "node --import=./scripts/register-loader.mjs scripts/seo/image-seo-audit.mts",
    "qa": "node scripts/qa.mjs",
    "qa:backend": "node --import=./scripts/register-loader.mjs scripts/qa/backend-contract.mts",
    "qa:live": "node --import=./scripts/register-loader.mjs scripts/qa/live-journey.mts",
    "qa:signup": "node scripts/qa/probe-signup.mjs",
    "qa:catalog": "node --import=./scripts/register-loader.mjs scripts/qa/catalog-2027.mts",
    "qa:order-flow": "node --import=./scripts/register-loader.mjs scripts/qa/order-flow.mts",
    "images:manifest": "node --import=./scripts/register-loader.mjs scripts/generate-fabric-image-manifest.mts",
    "images:progress": "node --import=./scripts/register-loader.mjs scripts/update-fabric-image-progress.mts",
    "qa:seo-runtime": "node scripts/qa/seo-runtime.mjs",
    "qa:seo-browser": "node scripts/qa/seo-browser-performance.mjs",
    "qa:performance": "node scripts/qa/performance-budget.mjs",
    "qa:preferences": "node --import=./scripts/register-loader.mjs scripts/qa/market-preferences.mts",
    "report:catalog": "node --import=./scripts/register-loader.mjs scripts/generate-catalog-report.mts",
    "report:catalog-images": "node --import=./scripts/register-loader.mjs scripts/generate-image-inventory.mts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
