# FabStitch frontend configuration.
#
# Copy to `.env.local` when a deployment needs values different from these
# examples. Browser requests use HttpOnly session cookies issued by the API.

# Canonical origin used by sitemaps, canonicals and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authoritative backend API and WebSocket origins.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1

# Staffed inbox used by /help and /support. Leave unset until it exists.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Public business inbox shown on /contact. Falls back to the support inbox.
NEXT_PUBLIC_CONTACT_EMAIL=
