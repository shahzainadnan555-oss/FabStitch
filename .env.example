# FabStitch frontend configuration.
#
# Copy to `.env.local` only when a value must differ from these defaults.
# Browser requests use HttpOnly session cookies issued by the API.

# Canonical origin used by metadataBase, sitemaps, canonicals and structured data.
# Production Vercel value (also committed in .env.production):
NEXT_PUBLIC_SITE_URL=https://fabstitch.net
# Local override only:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authoritative live backend. Production must keep these values.
# Next.js inlines NEXT_PUBLIC_* into the browser bundle.
NEXT_PUBLIC_API_BASE_URL=https://api.fabstitch.net/api/v1
VITE_API_BASE_URL=https://api.fabstitch.net/api/v1
NEXT_PUBLIC_WS_BASE_URL=wss://api.fabstitch.net/api/v1

# Optional local override only. Do not use this in production.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1

# Staffed inbox used by /help and /support. Leave unset until it exists.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Public business inbox shown on /contact. Falls back to the support inbox.
NEXT_PUBLIC_CONTACT_EMAIL=
